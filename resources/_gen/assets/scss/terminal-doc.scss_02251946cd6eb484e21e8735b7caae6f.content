@import url("https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=VT323&display=swap");html,body,body[a="dark"],body[a="auto"]{filter:none !important}img,img.ioda{filter:none !important}*,*::before,*::after{box-sizing:border-box}@keyframes blinkCursor{0%,49%{opacity:1}50%,100%{opacity:0}}@keyframes lineAppear{from{opacity:0;transform:translateY(2px)}to{opacity:1;transform:translateY(0)}}:root{--ws-bg: #0b0f0e;--ws-panel: #111816;--ws-border: #1a2f23;--ws-green: #00b347;--ws-green-glow: rgba(0,204,85,0.25);--ws-cyan: #0db;--ws-dim: #527563;--ws-text-light: #d6e8df;--paper-bg: #fff;--paper-text: #171b19;--paper-muted: #596961;--paper-border: #e0e8e3;--paper-code-bg: #eef4f0;--paper-code-text: #05662a;--paper-accent: #00883a;--paper-link: #073;--paper-link-hover: #00aa4a;--paper-hr: #dbe4de;--term-pre-bg: #0c1210;--term-pre-border: #1a3023;--term-pre-text: #e2f0e8;--term-pre-green: #0f6;--font-mono: Fira Code,ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,Liberation Mono,monospace;--font-retro: VT323,monospace}body.workstation-body{margin:0;padding:0;background-color:var(--ws-bg);color:var(--paper-text);font-family:var(--font-mono);font-size:16px;line-height:1.68;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;min-height:100vh}.workstation-wrapper{min-height:100vh;display:flex;flex-direction:column;background:radial-gradient(circle at 50% 0%, #131c18 0%, var(--ws-bg) 75%),linear-gradient(rgba(0,255,102,0.02) 1px, transparent 1px),linear-gradient(90deg, rgba(0,255,102,0.02) 1px, transparent 1px);background-size:100% 100%, 32px 32px, 32px 32px}.workstation-top-bar{position:sticky;top:0;z-index:1000;height:44px;background:rgba(16,22,20,0.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--ws-border);display:flex;align-items:center;justify-content:space-between;padding:0 1.25rem;color:var(--ws-text-light);font-size:0.88rem}.ws-bar-left{display:flex;align-items:center;gap:1rem}.ws-logo{display:flex;align-items:center;gap:0.45rem;color:var(--ws-green);text-decoration:none;font-weight:700;letter-spacing:0.03em;transition:all 0.2s ease}.ws-logo:hover{color:#ffffff;text-shadow:0 0 10px var(--ws-green)}.ws-logo .ws-logo-icon{color:#ffcc00}.ws-status-chip{display:inline-flex;align-items:center;gap:0.4rem;font-size:0.78rem;color:var(--ws-dim);background:rgba(0,204,85,0.06);border:1px solid rgba(0,204,85,0.18);padding:2px 8px;border-radius:3px}.ws-dot{width:6px;height:6px;background:var(--ws-green);border-radius:50%;box-shadow:0 0 6px var(--ws-green)}.ws-bar-right{display:flex;align-items:center;gap:0.5rem}.ws-btn{display:inline-flex;align-items:center;gap:0.35rem;color:var(--ws-text-light);text-decoration:none;background:#151d1a;border:1px solid var(--ws-border);padding:4px 10px;border-radius:3px;font-size:0.8rem;font-family:var(--font-mono);transition:all 0.2s ease}.ws-btn:hover{background:#1c2723;color:#ffffff;border-color:var(--ws-green)}.ws-btn.active{background:rgba(0,204,85,0.15);color:var(--ws-green);border-color:var(--ws-green);font-weight:600}.ws-btn.home-btn{color:#ffffff;background:rgba(0,204,85,0.12);border-color:rgba(0,204,85,0.4)}.ws-btn.home-btn:hover{background:var(--ws-green);color:#000000;font-weight:bold;box-shadow:0 0 12px var(--ws-green)}.term-window-container{flex:1;max-width:900px;width:100%;margin:1.75rem auto 2.5rem auto;padding:0 1rem}.term-window{background:var(--paper-bg);border:1px solid var(--ws-border);border-radius:8px;overflow:hidden;box-shadow:0 16px 40px rgba(0,0,0,0.6),0 0 0 1px rgba(0,204,85,0.15);display:flex;flex-direction:column}.term-window-titlebar{background:#131a17;border-bottom:1px solid var(--ws-border);padding:0.65rem 1rem;display:flex;align-items:center;justify-content:space-between;color:#a0b8ac;font-size:0.82rem;user-select:none}.term-window-controls{display:flex;align-items:center;gap:7px}.win-btn{width:12px;height:12px;border-radius:50%;display:inline-block;opacity:0.85}.win-btn.win-close{background:#ff5f56;box-shadow:0 0 4px rgba(255,95,86,0.5)}.win-btn.win-min{background:#ffbd2e;box-shadow:0 0 4px rgba(255,189,46,0.5)}.win-btn.win-max{background:#27c93f;box-shadow:0 0 4px rgba(39,201,63,0.5)}.term-window-title{display:flex;align-items:center;gap:0.45rem;color:#c0d8cc;font-weight:500;max-width:60%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.term-window-title .win-title-icon{font-size:0.95rem}.term-window-meta{color:var(--ws-green);font-size:0.76rem;letter-spacing:0.05em}.term-window-body{background:var(--paper-bg);color:var(--paper-text);padding:2.5rem 3rem}.document-canvas{max-width:780px;margin:0 auto}.cli-prompt-line{background:#f4f8f5;border:1px solid #dbe6df;border-left:4px solid var(--paper-accent);padding:0.65rem 0.95rem;border-radius:4px;margin-bottom:1.5rem;font-size:0.92rem;display:flex;flex-wrap:wrap;align-items:center;gap:0.35rem;box-shadow:inset 0 1px 3px rgba(0,0,0,0.03)}.cli-prompt-user{color:var(--paper-accent);font-weight:600}.cli-prompt-path a{color:#0b4f2c;text-decoration:none;font-weight:600}.cli-prompt-path a:hover{text-decoration:underline;color:var(--paper-link-hover)}.cli-prompt-cmd{color:#1a221e;font-weight:600}.cli-cursor{color:var(--paper-accent);animation:blinkCursor 1s infinite;font-weight:bold}.tty-header-card{border:1px solid var(--paper-border);background:#fafcfb;border-radius:5px;padding:0.85rem 1rem;margin-bottom:1.75rem;font-size:0.84rem;display:flex;flex-direction:column;gap:0.5rem}.tty-header-row{display:flex;flex-wrap:wrap;align-items:center;gap:0.65rem}.tty-badge{display:inline-flex;align-items:center;gap:0.3rem;background:#ffffff;border:1px solid #d4dfd8;padding:3px 8px;border-radius:3px;color:#2a3530}.tty-label{color:var(--paper-accent);font-weight:700;font-size:0.76rem;letter-spacing:0.04em}.tty-tags-row{display:flex;flex-wrap:wrap;align-items:center;gap:0.4rem;padding-top:0.35rem;border-top:1px dashed #e2eae5}.tty-tag-pill{background:#eef5f1;color:#0b592c;border:1px solid #ceddd4;padding:2px 7px;border-radius:3px;font-size:0.78rem;font-weight:500}.post-title{font-size:2.2rem;font-weight:700;line-height:1.25;color:#0b1410;margin:0.5rem 0 1.25rem 0;letter-spacing:-0.02em}.post-title::before{content:"# ";color:var(--paper-accent);font-weight:400}.post-content h2{font-size:1.45rem;font-weight:700;color:#0d1a14;margin:2.6rem 0 1rem 0;padding-bottom:0.45rem;border-bottom:1px dashed var(--paper-border);letter-spacing:-0.01em}.post-content h2::before{content:"## ";color:var(--paper-accent);font-weight:normal;font-size:1.15rem}.post-content h3{font-size:1.18rem;font-weight:600;color:#12241c;margin:1.8rem 0 0.75rem 0}.post-content h3::before{content:"### ";color:#008899;font-weight:normal;font-size:0.95rem}.post-content p{margin:1.15rem 0;color:var(--paper-text);line-height:1.7}.post-content strong{color:#000000;font-weight:600}.post-content a{color:var(--paper-link);text-decoration:none;border-bottom:1px dashed var(--paper-link);padding-bottom:1px;transition:all 0.15s ease}.post-content a:hover{color:var(--paper-link-hover);border-bottom-style:solid;background:rgba(0,204,85,0.08)}.post-content ul,.post-content ol{margin:1.1rem 0;padding-left:1.6rem}.post-content li{margin:0.45rem 0;line-height:1.65}.post-content hr{margin:2.5rem 0;border:0;height:1px;background:repeating-linear-gradient(90deg, var(--paper-accent), var(--paper-accent) 6px, transparent 6px, transparent 12px);opacity:0.45}.post-content iframe{max-width:100%;border-radius:6px;border:1px solid var(--paper-border);box-shadow:0 4px 16px rgba(0,0,0,0.1);margin:1.25rem auto;display:block}.terminal-file-list{list-style:none !important;padding:0 !important;margin:1.2rem 0 !important}.file-list-item{display:flex;align-items:baseline;gap:0.75rem;padding:0.55rem 0.6rem;border-bottom:1px dashed var(--paper-border);transition:background 0.15s ease}.file-list-item:hover{background:#f0f7f2}.file-date{color:var(--paper-muted);font-size:0.85rem;white-space:nowrap;font-family:var(--font-mono)}.file-arrow{color:var(--paper-accent);font-weight:bold}.file-link{color:var(--paper-link) !important;text-decoration:none !important;font-weight:600;border-bottom:none !important}.file-link:hover{color:var(--paper-link-hover) !important;text-decoration:underline !important;background:none !important}code:not(pre code){background:var(--paper-code-bg) !important;color:var(--paper-code-text) !important;border:1px solid #ceddd4 !important;border-radius:4px;padding:0.15em 0.42em;font-size:0.88em;font-family:var(--font-mono);font-weight:500}pre{background:var(--term-pre-bg) !important;border:1px solid var(--term-pre-border) !important;border-radius:6px;padding:1.1rem 1.25rem !important;margin:1.6rem 0 !important;overflow-x:auto;box-shadow:0 4px 16px rgba(0,0,0,0.35);position:relative;scrollbar-width:thin;scrollbar-color:var(--term-pre-border) rgba(0,0,0,0)}pre::-webkit-scrollbar{width:6px;height:6px}pre::-webkit-scrollbar-track{background:rgba(0,0,0,0)}pre::-webkit-scrollbar-thumb{background:var(--term-pre-border);border-radius:3px}pre code{background:transparent !important;color:var(--term-pre-green) !important;font-family:var(--font-mono);font-size:0.9rem;line-height:1.5;border:none !important;padding:0 !important}blockquote{margin:1.6rem 0;padding:1rem 1.35rem;background:#f3f8f5;border:1px solid #dbe6df;border-left:4px solid var(--paper-accent);border-radius:0 6px 6px 0;font-style:normal;color:#1e2824}blockquote p{margin:0.4rem 0}table{width:100%;border-collapse:collapse;margin:1.8rem 0;font-size:0.92rem;border:1px solid var(--paper-border);border-radius:6px;overflow:hidden}table th{background:#111a16;color:#00ff88;font-weight:600;text-align:left;padding:0.75rem 0.95rem;border:1px solid #22352b;font-size:0.85rem;letter-spacing:0.03em}table td{padding:0.7rem 0.95rem;border:1px solid var(--paper-border);background:#ffffff;color:var(--paper-text)}table tr:nth-child(even) td{background:#fbfdfc}table tr:hover td{background:#f0f7f2}img{max-width:100%;height:auto;border-radius:6px;border:1px solid var(--paper-border);box-shadow:0 4px 16px rgba(0,0,0,0.07);margin:1.5rem auto;display:block}.translations-badge{background:#f3f8f5;border:1px solid #dce7e1;padding:0.55rem 0.9rem;border-radius:4px;margin-bottom:1.5rem;font-size:0.86rem;display:flex;align-items:center;gap:0.6rem}.eof-marker{margin:3.5rem 0 1.5rem 0;text-align:center;font-size:0.82rem;color:var(--paper-muted);letter-spacing:0.08em}.post-footer-nav{display:flex;flex-wrap:wrap;gap:0.75rem;justify-content:space-between;margin-top:1rem;padding-top:1.5rem;border-top:1px dashed var(--paper-border)}.cli-btn{display:inline-flex;align-items:center;gap:0.45rem;background:#f2f7f4;border:1px solid #cadcd1;color:#0b592c;padding:8px 16px;border-radius:4px;text-decoration:none !important;font-size:0.86rem;font-weight:600;transition:all 0.2s ease}.cli-btn:hover{background:#0b592c;color:#ffffff !important;border-color:#0b592c;box-shadow:0 2px 8px rgba(11,89,44,0.2)}.term-window-statusbar{background:#111815;border-top:1px solid var(--ws-border);padding:0.5rem 1rem;display:flex;align-items:center;justify-content:space-between;color:#8fa89b;font-size:0.76rem;user-select:none}.status-left,.status-right{display:flex;align-items:center;gap:0.75rem}.status-mode{background:var(--ws-green);color:#000000;font-weight:700;padding:1px 6px;border-radius:2px;font-size:0.72rem}.status-filename{color:#d2e4db;font-weight:500}.status-action{color:#8fa89b;text-decoration:none;padding:2px 6px;border:1px solid rgba(255,255,255,0.1);border-radius:2px;transition:all 0.15s ease}.status-action:hover{color:var(--ws-green);border-color:var(--ws-green)}@media (max-width: 768px){.workstation-wrapper{background:var(--ws-bg)}.workstation-top-bar{padding:0 0.75rem;height:42px}.ws-status-chip{display:none}.term-window-container{margin:0;padding:0;max-width:100%}.term-window{border-radius:0;border-left:none;border-right:none;border-top:none;box-shadow:none}.term-window-titlebar{padding:0.5rem 0.75rem}.term-window-title{max-width:80%}.term-window-body{padding:1.5rem 1rem}.post-title{font-size:1.6rem}.post-content h2{font-size:1.25rem}.post-footer-nav{flex-direction:column}.cli-btn{justify-content:center}}
